# Copy to .env.local (git-ignored) and fill in the source(s) you use for "Fetch real metrics".
# The browser never sees these values: the dev/preview server adds the tokens when it forwards /obs/... requests.

# Prometheus, queried directly
#MICROWAVE_PROMETHEUS_URL=http://localhost:9090
#MICROWAVE_PROMETHEUS_TOKEN=

# Grafana, through its datasource proxy (service account token with datasources:query)
#MICROWAVE_GRAFANA_URL=https://grafana.example.com
#MICROWAVE_GRAFANA_TOKEN=glsa_xxx

# Grafana MCP server (mcp-grafana) in streamable-http mode
#MICROWAVE_MCP_URL=http://localhost:8000/mcp
#MICROWAVE_MCP_TOKEN=
